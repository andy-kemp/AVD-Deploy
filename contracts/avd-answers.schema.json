{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.example.invalid/avd/answers/v1.0.0",
  "title": "AVD deployment answers",
  "description": "Answers collected by the portal (ADR 0017). avd.ps1 -Mode New -AnswersFile turns them into a contract configuration with the same code as the local web wizard. Property names match the avd.ps1 parameters. Group creation, name availability and the AVD service principal are resolved when the configuration is generated, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "answersVersion", "SubscriptionId", "Location", "Prefix", "ResourceGroupName", "NetworkMode", "Hosting", "Persona",
    "Users", "ImageSku", "VmSize", "ScalingPreset", "WorkspaceName", "DesktopName"
  ],
  "properties": {
    "answersVersion": { "const": "1.0.0" },
    "SubscriptionId": { "$ref": "#/definitions/guid" },
    "Location": { "type": "string", "pattern": "^[a-z0-9]{1,40}$" },
    "Prefix": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,9}$" },
    "ResourceGroupName": { "type": "string", "pattern": "^[A-Za-z0-9._()\\-]{1,90}$" },
    "NetworkMode": { "enum": ["New", "Existing"] },
    "AddressSpace": { "type": "string", "pattern": "^\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}\\.0/(1[6-9]|2[0-4])$" },
    "VirtualNetworkName": { "$ref": "#/definitions/networkName" },
    "SessionHostSubnet": { "$ref": "#/definitions/networkName" },
    "PrivateEndpointSubnet": { "$ref": "#/definitions/networkName" },
    "UsersGroup": { "$ref": "#/definitions/guid" },
    "AdminsGroup": { "$ref": "#/definitions/guid" },
    "NewUsersGroup": { "$ref": "#/definitions/groupName" },
    "NewAdminsGroup": { "$ref": "#/definitions/groupName" },
    "AddMeToUsersGroup": { "type": "boolean" },
    "Hosting": { "enum": ["Shared", "Dedicated"] },
    "Persona": { "enum": ["Frontline", "Standard", "Heavy"] },
    "Users": { "type": "integer", "minimum": 1, "maximum": 5000 },
    "PeakConcurrencyPct": { "type": "integer", "minimum": 1, "maximum": 100 },
    "ImageSku": { "enum": ["win11-24h2-ent", "win11-24h2-avd", "win11-24h2-avd-m365"] },
    "VmSize": { "type": "string", "pattern": "^Standard_[A-Za-z0-9_]{1,55}$" },
    "UserIdentity": { "enum": ["Hybrid", "CloudOnly"] },
    "KerberosDomainName": { "type": "string", "pattern": "^([A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}$" },
    "KerberosDomainGuid": { "$ref": "#/definitions/guid" },
    "ProfileFailureAction": { "enum": ["TempProfile", "Block"] },
    "ScalingPreset": { "enum": ["BusinessHours", "None"] },
    "TimeZone": { "type": "string", "pattern": "^[A-Za-z0-9 ().+\\-]{1,64}$" },
    "WorkdayStart": { "$ref": "#/definitions/time" },
    "WorkdayEnd": { "$ref": "#/definitions/time" },
    "WorkspaceName": { "$ref": "#/definitions/displayName" },
    "DesktopName": { "$ref": "#/definitions/displayName" }
  },
  "allOf": [
    {
      "if": { "properties": { "NetworkMode": { "const": "New" } } },
      "then": { "required": ["AddressSpace"] },
      "else": { "required": ["VirtualNetworkName", "SessionHostSubnet", "PrivateEndpointSubnet"] }
    },
    { "oneOf": [{ "required": ["UsersGroup"] }, { "required": ["NewUsersGroup"] }] },
    { "oneOf": [{ "required": ["AdminsGroup"] }, { "required": ["NewAdminsGroup"] }] },
    {
      "if": { "properties": { "Hosting": { "const": "Shared" } } },
      "then": { "required": ["PeakConcurrencyPct", "UserIdentity", "ProfileFailureAction"] }
    },
    {
      "if": { "properties": { "UserIdentity": { "const": "Hybrid" } }, "required": ["UserIdentity"] },
      "then": { "required": ["KerberosDomainName", "KerberosDomainGuid"] }
    },
    {
      "if": { "properties": { "ScalingPreset": { "const": "BusinessHours" } } },
      "then": { "required": ["TimeZone", "WorkdayStart", "WorkdayEnd"] }
    }
  ],
  "definitions": {
    "guid": { "type": "string", "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$" },
    "networkName": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]{0,79}$" },
    "groupName": { "type": "string", "pattern": "^[^@\"\\\\/\\[\\]:|<>+=;,?*]{1,120}$" },
    "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "displayName": { "type": "string", "pattern": "^[^\\u0000-\\u001f<>]{1,64}$" }
  }
}
